{
  "name": "mk8dx-table-maker-discord-bot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning src/index.ts",
    "register": "node --env-file=.env --disable-warning=ExperimentalWarning scripts/register.ts",
    "add-guild": "node --env-file=.env --disable-warning=ExperimentalWarning scripts/add-guild.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "secrets:sync": "node scripts/sync-secrets.ts",
    "verify:ocr": "node --env-file=.env scripts/verify-ocr.ts",
    "preview": "node --env-file=.env scripts/preview.ts"
  },
  "dependencies": {
    "@google/genai": "2.16.0",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
