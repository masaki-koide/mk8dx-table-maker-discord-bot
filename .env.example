# Gemini
# 濫用対策として、このキーを発行する Google Cloud プロジェクトでは
# 課金を有効にしないこと（無料枠を超えたら 429 で止まり、請求が発生しない）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Discord（配管の実装後に使う）
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# allowlist（カンマ区切り）
# 空のリストは「そのフィルタを使わない」の意味。
# 両方とも空だと誰でも実行できてしまうため、その場合は起動を拒否する。
# 身内サーバーで使うなら ALLOWED_GUILD_IDS だけでよい。
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=

# レート制限
RATE_LIMIT_PER_USER_HOUR=20
RATE_LIMIT_GLOBAL_DAY=100
